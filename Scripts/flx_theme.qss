/* flx_theme.qss — ثيم FlxAHK المظلم (نسخة مُصقولة)
   لوحة واحدة: رمادي بارد موحّد + لمسة ذهبية هادئة كلون تمييز وحيد.
   مقياس الزوايا: حاويات 12 · عناصر تحكم 8 · شارات 14 */

/* ---------- الأساس ---------- */

QWidget {
    background-color: #16161a;
    color: #ececf1;
    font-family: "Segoe UI";
    font-size: 10pt;
    font-weight: 400;
}

QMainWindow, QDialog {
    background-color: #16161a;
}

QWidget:disabled { color: #63636d; }

/* ---------- الشريط الجانبي ---------- */

#Sidebar {
    background-color: #121215;
    border-left: 1px solid #26262d;
}

#AppTitle {
    color: #e5bd58;
    font-size: 13pt;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 20px 12px 4px 12px;
    background: transparent;
}

#SidebarHint {
    color: #6d6d78;
    font-size: 8pt;
    background: transparent;
}

#SidebarButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 11px 14px;
    text-align: right;
    color: #a8a8b3;
    font-size: 10.5pt;
    font-weight: 500;
}

#SidebarButton:hover {
    background-color: #1e1e25;
    color: #ffffff;
}

#SidebarButton:checked {
    background-color: #26262f;
    color: #e5bd58;
    font-weight: 600;
    border-right: 3px solid #e5bd58;
    padding-right: 11px;
}

#SidebarButton:pressed { background-color: #1a1a21; }

/* ---------- نصوص ---------- */

QLabel { background: transparent; }

#PageTitle {
    font-size: 17pt;
    font-weight: 600;
    color: #ffffff;
}

#Subtitle {
    color: #8b8b96;
    font-size: 9pt;
}

QLabel[role="hint"] {
    color: #77777f;
    font-size: 8.5pt;
}

#GoldHeader {
    color: #e5bd58;
    font-size: 11.5pt;
    font-weight: 600;
}

#StateOk   { color: #7bc47f; font-weight: 600; }
#StateBad  { color: #d96a6a; font-weight: 600; }

/* ---------- شريط الحالة العلوي ---------- */

#StatStrip {
    background-color: #1d1d23;
    border: 1px solid #2b2b34;
    border-radius: 12px;
}

#StatValue {
    font-size: 15pt;
    font-weight: 600;
    color: #e5bd58;
    background: transparent;
}

#StatValueMono {
    font-family: "Consolas";
    font-size: 12.5pt;
    font-weight: 600;
    color: #e5bd58;
    background: transparent;
}

#StatLabel {
    color: #90909b;
    font-size: 8.5pt;
    background: transparent;
}

#StripDivider { color: #2b2b34; background-color: #2b2b34; }

/* ---------- الحقول ---------- */

QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox {
    background-color: #1d1d24;
    border: 1px solid #33333d;
    border-radius: 8px;
    padding: 7px 11px;
    selection-background-color: #45455a;
    font-weight: 400;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QComboBox:focus, QSpinBox:focus {
    border: 1px solid #e5bd58;
}

QLineEdit[invalid="true"] {
    border: 1px solid #d96a6a;
    background-color: #241a1c;
}

QLineEdit[readonly="true"] { color: #9a9aa5; }

QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background-color: #20202a;
    border: 1px solid #3a3a46;
    border-radius: 8px;
    selection-background-color: #2c2c3a;
    selection-color: #e5bd58;
    outline: none;
    padding: 4px;
}

QSpinBox::up-button, QSpinBox::down-button {
    background: #26262f; border: none; width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #31313d; }

/* ---------- الأزرار ---------- */

QPushButton {
    background-color: #26262f;
    border: 1px solid #383844;
    border-radius: 8px;
    padding: 8px 18px;
    color: #e6e6ec;
    font-weight: 500;
}

QPushButton:hover { background-color: #2e2e3a; border-color: #454554; }
QPushButton:pressed { background-color: #212129; padding-top: 9px; padding-bottom: 7px; }
QPushButton:focus { border: 1px solid #e5bd58; }

#PrimaryButton {
    background-color: #caa03c;
    border: 1px solid #e5bd58;
    color: #1a1608;
    font-weight: 600;
}
#PrimaryButton:hover { background-color: #dbb04a; }
#PrimaryButton:pressed { background-color: #b8933a; }

#DangerButton {
    background-color: rgba(64, 30, 32, 0.75);
    border: 1px solid #6e3a3c;
    color: #eba0a0;
}
#DangerButton:hover { background-color: rgba(110, 48, 50, 0.85); color: #ffd9d9; }
#DangerButton:pressed { background-color: rgba(88, 38, 40, 0.95); }

/* ---------- مربعات الاختيار والراديو ---------- */

QCheckBox, QRadioButton { spacing: 8px; background: transparent; font-weight: 400; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid #4a4a57;
    background: #1d1d24;
}
QCheckBox::indicator { border-radius: 5px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #e5bd58; }
QCheckBox::indicator:checked { background: #e5bd58; border-color: #e5bd58; }
QRadioButton::indicator:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.9, fx:0.5, fy:0.5,
                stop:0 #e5bd58, stop:0.45 #e5bd58, stop:0.55 #1d1d24, stop:1 #1d1d24);
    border-color: #e5bd58;
}

/* ---------- الجداول والقوائم ---------- */

QTableWidget, QTableView, QListWidget, QTreeWidget {
    background-color: #1a1a20;
    alternate-background-color: #1e1e25;
    border: 1px solid #2b2b34;
    border-radius: 12px;
    gridline-color: #232329;
    selection-background-color: #2c2c3c;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QHeaderView::section {
    background-color: #1d1d24;
    color: #cfa94a;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #e5bd58;
    font-weight: 600;
    font-size: 9pt;
}

QTableCornerButton::section { background-color: #1d1d24; border: none; }

QTableWidget::item, QTableView::item { padding: 5px 8px; border: none; }
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #2c2c3c;
    border-right: 2px solid #e5bd58;
}

QListWidget::item { padding: 8px 10px; border-radius: 6px; margin: 1px 2px; }
QListWidget::item:selected { background-color: #2c2c3c; color: #ffffff; }
QListWidget::item:hover:!selected { background-color: #222229; }

/* ---------- المجموعات ---------- */

QGroupBox {
    background-color: #191920;
    border: 1px solid #2b2b34;
    border-radius: 12px;
    margin-top: 12px;
    padding: 14px 12px 10px 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    right: 14px;
    color: #e5bd58;
    background-color: #16161a;
    padding: 0 6px;
    font-weight: 600;
}

/* ---------- القوائم المنبثقة ---------- */

QMenu {
    background-color: #20202a;
    border: 1px solid #3a3a46;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 22px 7px 22px;
    border-radius: 6px;
    background: transparent;
}

QMenu::item:selected { background-color: #2c2c3a; color: #ffffff; }
QMenu::item:disabled { color: #5c5c66; }
QMenu::separator { height: 1px; background: #33333d; margin: 5px 10px; }

/* ---------- أشرطة التمرير ---------- */

QScrollBar:vertical { background: transparent; width: 9px; margin: 3px; }
QScrollBar::handle:vertical {
    background: #34343f; border-radius: 4px; min-height: 32px;
}
QScrollBar::handle:vertical:hover { background: #434350; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 3px; }
QScrollBar::handle:horizontal {
    background: #34343f; border-radius: 4px; min-width: 32px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- الحالة الفارغة ---------- */

#EmptyState {
    color: #5f5f6a;
    font-size: 10.5pt;
    background: transparent;
}

/* ---------- الرسائل والتلميحات ---------- */

QMessageBox, QInputDialog { background-color: #1c1c24; }
QMessageBox QLabel { color: #ececf1; }

QToolTip {
    background-color: #23232c;
    color: #e8c86a;
    border: 1px solid #3d3d4a;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 9pt;
}

/* ---------- شريط الحالة السفلي ---------- */

QStatusBar {
    background: #131318;
    border-top: 1px solid #26262d;
    color: #9a9aa5;
}

QStatusBar::item { border: none; }

/* ---------- البحث ---------- */

#SearchField {
    border-radius: 14px;
    padding: 7px 16px;
    background-color: #1d1d24;
}
